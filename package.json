{
  "name": "agent-petrel",
  "version": "0.1.0",
  "description": "ASCII storm petrels for agent interfaces: framework-free Canvas engine and web component",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/sdk/types/index.d.ts",
      "import": "./dist/sdk/petrel.js"
    }
  },
  "files": [
    "dist/sdk",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "showcase:prepare": "node scripts/prepare-showcase.mjs",
    "showcase:check": "npm --prefix showcase run check",
    "showcase:render": "npm --prefix showcase run render -- --fps 30 --quality delivery --output ../media/agent-petrel-10s.mp4"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@playwright/test": "^1.56.0",
    "gsap": "^3.14.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
